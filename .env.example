# =================================================================
# GrabPic Environment Configuration Template
# Copy this file to .env before starting the services
# =================================================================

# Azure Blob Storage Configuration (Optional - set USE_BLOB_STORAGE=true if using Azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=events
USE_BLOB_STORAGE=false

# Cryptographic Token Secret (Change in production)
IMAGE_TOKEN_SECRET=your-secret-key-change-in-production

# Event Expiration Time-to-Live (Hours)
EVENT_EXPIRY_HOURS=10

# AI Microservice Public Base URL (Used by Backend for generating signed image links)
AI_PUBLIC_BASE_URL=http://localhost:8000
